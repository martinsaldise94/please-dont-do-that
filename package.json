{
  "name": "pdtd",
  "version": "0.1.0",
  "description": "A CLI that scores how generic a frontend project is — could this site belong to any other business unchanged?",
  "type": "module",
  "bin": {
    "pdtd": "bin/pdtd.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/pdtd.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "coverage": "c8 node --test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "cli",
    "frontend",
    "ai",
    "landing-page",
    "generic",
    "linter"
  ],
  "author": "martinsaldise94",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinsaldise94/please-dont-do-that.git"
  },
  "bugs": {
    "url": "https://github.com/martinsaldise94/please-dont-do-that/issues"
  },
  "homepage": "https://github.com/martinsaldise94/please-dont-do-that#readme",
  "files": [
    "bin/",
    "core/",
    "rules/",
    "prompts/"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^11.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "node-html-parser": "^7.1.0"
  }
}
